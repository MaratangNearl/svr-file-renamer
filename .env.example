# GitHub 공개 이미지. 제작자가 첫 릴리스를 게시한 후 사용 가능합니다.
IMAGE=ghcr.io/maratangnearl/svr-file-renamer:latest
# Ubuntu 호스트의 실제 파일 저장소 (컨테이너에서는 /media).
MEDIA_PATH=/srv/media
CONFIG_PATH=./data
PUID=1000
PGID=1000
# NAS IP로 직접 접속: http://NAS_IP:18080
BIND_ADDRESS=0.0.0.0
PORT=18080
TZ=Asia/Seoul
COOKIE_SECURE=false
